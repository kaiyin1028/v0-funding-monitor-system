# Hong Kong Education Funding Monitor System
# Environment Variables Configuration
# Copy this file to .env.local and configure your values

# ===========================================
# API Configuration
# ===========================================
# Base URL for the backend API
# In production, this should point to your deployed API server
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Enable mock mode for development without backend
# Set to "true" to use mock data, "false" to call real API
NEXT_PUBLIC_USE_MOCKS=true

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Database Configuration (Backend)
# ===========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Supabase (if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Authentication (Backend)
# ===========================================
# JWT secret for signing tokens (generate a secure random string)
JWT_SECRET=

# JWT token expiration time
JWT_EXPIRES_IN=1h

# Refresh token expiration time
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# AI Integration (Optional)
# ===========================================
# OpenAI API Key for AI-powered features
OPENAI_API_KEY=

# Anthropic API Key (alternative AI provider)
ANTHROPIC_API_KEY=

# ===========================================
# Email Notifications (Optional)
# ===========================================
# SMTP configuration for sending email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hkeeia.org.hk

# Email address to receive system notifications
NOTIFICATION_EMAIL=

# ===========================================
# Web Scraping Configuration (Backend)
# ===========================================
# Interval between website checks (in seconds)
# Default: 86400 (24 hours)
SCRAPING_INTERVAL=86400

# Proxy URL for web scraping (optional)
PROXY_URL=

# ===========================================
# Logging and Monitoring
# ===========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Sentry DSN for error tracking (optional)
SENTRY_DSN=
